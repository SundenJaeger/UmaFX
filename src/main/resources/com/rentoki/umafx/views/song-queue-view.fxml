<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rentoki.umafx.controller.SongQueueController">
   <left>
      <ListView fx:id="songQueueListView" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </left>
   <center>
      <VBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#addFolder" text="Add Folder" />
                  <Button mnemonicParsing="false" onAction="#addSong" text="Add Song" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="removeSongButton" mnemonicParsing="false" onAction="#removeSong" text="Remove Song" />
                  <Button fx:id="removeAllSongButton" mnemonicParsing="false" onAction="#removeAllSong" text="Remove All Song" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
